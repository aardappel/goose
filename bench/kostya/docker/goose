FROM langarena:base_clang

ARG version
RUN git clone https://github.com/aardappel/goose /opt/goose \
    && cd /opt/goose \
    && git checkout $version \
    && cmake -B build -DCMAKE_BUILD_TYPE=Release -DGOOSE_LIBTCC=OFF -DGOOSE_GFX=OFF \
       -DGOOSE_AUDIO=OFF -DGOOSE_PHYSICS=OFF -DGOOSE_UI=OFF \
    && cmake --build build --target goose -j \
    && ln -s /opt/goose/build/goose /usr/local/bin/goose
