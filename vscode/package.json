{
  "name": "goose-language",
  "icon": "../docs/logo/logo_black_fg_white_bg_plus_text_square.png",
  "displayName": "Goose Language",
  "description": "Syntax highlighting, Goose-written language server, formatting, compiler diagnostics, navigation and tasks for Goose.",
  "version": "0.4.2",
  "publisher": "aardappel",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/aardappel/goose.git",
    "directory": "vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "goose"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:goose",
    "onTaskType:goose",
    "onDebugResolve:goose",
    "onDebugInitialConfigurations",
    "onDebugDynamicConfigurations:goose"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Syntax highlighting, snippets and the outline work in Restricted Mode. Running the compiler requires a trusted workspace.",
      "restrictedConfigurations": [
        "goose.compilerPath",
        "goose.languageServerPath",
        "goose.entryFile",
        "goose.stdlibPath",
        "goose.runArguments"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Goose uses a compiler and source files on the extension host's filesystem."
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "node package_vsix.js",
    "vscode:prepublish": "npm test"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "goose",
        "aliases": [
          "Goose",
          "goose"
        ],
        "icon": {
          "dark": "./fileicons/goose-light-icon.svg",
          "light": "./fileicons/goose-dark-icon.svg"
        },
        "extensions": [
          ".goose"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "goose",
        "scopeName": "source.goose",
        "path": "./syntaxes/goose.tmLanguage.json"
      },
      {
        "scopeName": "markdown.goose.codeblock",
        "path": "./syntaxes/goose.markdown.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.goose": "goose"
        }
      }
    ],
    "snippets": [
      {
        "language": "goose",
        "path": "./snippets/goose.json"
      }
    ],
    "commands": [
      {
        "command": "goose.check",
        "title": "Check Program",
        "category": "Goose",
        "enablement": "editorLangId == goose && isWorkspaceTrusted"
      },
      {
        "command": "goose.run",
        "title": "Run with JIT",
        "category": "Goose",
        "icon": "$(play)",
        "enablement": "editorLangId == goose && isWorkspaceTrusted"
      },
      {
        "command": "goose.generateC",
        "title": "Generate C",
        "category": "Goose",
        "enablement": "editorLangId == goose && isWorkspaceTrusted"
      },
      {
        "command": "goose.showOutput",
        "title": "Show Compiler Output",
        "category": "Goose"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "goose.run",
          "when": "editorLangId == goose && isWorkspaceTrusted",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "goose.run",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b",
        "when": "editorLangId == goose && editorTextFocus && isWorkspaceTrusted && config.goose.useRunKeybindings"
      },
      {
        "command": "goose.run",
        "key": "ctrl+f5",
        "when": "editorLangId == goose && editorTextFocus && isWorkspaceTrusted && config.goose.useRunKeybindings && debugState == inactive"
      },
      {
        "command": "goose.run",
        "key": "f5",
        "when": "editorLangId == goose && editorTextFocus && isWorkspaceTrusted && config.goose.useRunKeybindings && debugState == inactive"
      }
    ],
    "debuggers": [
      {
        "type": "goose",
        "label": "Goose: Run with JIT",
        "languages": [
          "goose"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [],
            "properties": {
              "program": {
                "type": "string",
                "description": "Entry file. Defaults to goose.entryFile or the active Goose file.",
                "default": "${file}"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "goose",
            "request": "launch",
            "name": "Goose: Run with JIT",
            "noDebug": true
          }
        ],
        "configurationSnippets": [
          {
            "label": "Goose: Run with JIT",
            "description": "Run Goose in a task terminal using the compiler's JIT (no debugger).",
            "body": {
              "type": "goose",
              "request": "launch",
              "name": "Goose: Run with JIT",
              "noDebug": true
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "Goose",
      "properties": {
        "goose.compilerPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Compiler executable or command on PATH. Empty searches goose and build/{Release,Debug}/goose in the workspace, then PATH. Relative paths use the workspace folder. Supports ${workspaceFolder}."
        },
        "goose.languageServerPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Goose tools executable (goose-tools). Empty searches build/{Release,Debug}/goose-tools in the workspace, then PATH. Formatting, hover and completion are off if none is found. Relative paths use the workspace folder. Supports ${workspaceFolder}."
        },
        "goose.entryFile": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Program entry file, relative to the workspace folder. Empty checks/runs the current file, and a checked file without fn main() is accepted as a module. Set this to check imported modules together with the whole program. Supports ${workspaceFolder}."
        },
        "goose.stdlibPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Standard-library directory passed as --stdlib. Empty uses the compiler's default lookup (including GOOSE_STDLIB). Supports ${workspaceFolder}."
        },
        "goose.checkOnSave": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Check saved Goose files on open and save. Checks wait until open Goose files in the same workspace folder are saved."
        },
        "goose.useRunKeybindings": {
          "type": "boolean",
          "default": true,
          "description": "Run with JIT on Ctrl+Shift+B (Cmd+Shift+B on macOS), F5, and Ctrl+F5 while editing Goose. Disable to use VS Code's usual task/debug keybindings."
        },
        "goose.checkTimeout": {
          "type": "number",
          "default": 15000,
          "minimum": 1000,
          "maximum": 300000,
          "scope": "resource",
          "description": "Maximum time in milliseconds for a background compiler check."
        },
        "goose.runArguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "Program arguments passed after -- by Run Program. Each item is one argument."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "goose",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "run",
              "check",
              "generateC"
            ],
            "description": "Compiler operation. Run uses the JIT and is the contributed build task."
          },
          "file": {
            "type": "string",
            "description": "Source file relative to the workspace folder. Defaults to goose.entryFile or the active file. Supports ${workspaceFolder} and ${file}."
          },
          "output": {
            "type": "string",
            "description": "C output file for generateC; defaults to the source basename with .c."
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "goose",
        "owner": "goose-task",
        "source": "Goose",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.+?):(\\d+): (error|warning): (.*)$",
          "file": 1,
          "line": 2,
          "severity": 3,
          "message": 4
        }
      }
    ],
    "configurationDefaults": {
      "[goose]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.defaultFormatter": "aardappel.goose-language",
        "editor.formatOnSave": true
      }
    }
  }
}