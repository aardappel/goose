{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Goose",
  "scopeName": "source.goose",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#declarations" },
    { "match": "\\b(?:bool|varint|[iu](?:8|16|32|64)|f(?:32|64))\\b", "name": "storage.type.goose" },
    { "match": "\\b(?:true|false|null)\\b", "name": "constant.language.goose" },
    { "match": "\\bself\\b", "name": "variable.language.goose" },
    { "match": "\\b(?:if|else|while|for|in|loop|block|guard|match|return|break|continue)\\b", "name": "keyword.control.goose" },
    { "match": "\\b(?:import|namespace|as)\\b", "name": "keyword.other.goose" },
    { "match": "\\b(?:struct|enum|type|fn|thread_fn|let|var|const)\\b", "name": "storage.type.goose" },
    { "match": "\\b(?:extern|recursive|pad|reusable)\\b", "name": "storage.modifier.goose" },
    { "include": "#numbers" },
    { "match": "\\b(?:print|str|format|assert|abort|exit|hardware_threads|thread_spawn|thread_wait|qput|qget|qpoll|default|copy|to_bytes|bytes_of|from_bytes|embed_shader|index_of|push|append|pop|resize|clear|alloc_index|alloc_ref|free|alloc_slice|realloc_slice|free_slice)\\b(?=\\s*[<(])", "name": "support.function.goose" },
    { "match": "(?<=\\.)\\b(?:len|cap)\\b", "name": "support.variable.property.goose" },
    { "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*::)", "name": "entity.name.namespace.goose" },
    { "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()", "name": "entity.name.function.goose" },
    { "match": "\\b[A-Z][A-Z0-9_]*\\b", "name": "constant.other.goose" },
    { "match": "\\b[A-Z][A-Za-z0-9_]*\\b", "name": "entity.name.type.goose" },
    { "match": "\\.==|\\.!=|\\.=|\\.\\.|::|->|=>|<<=?|>>=?|[+*/%=&|^!<>-]=?|[?~]", "name": "keyword.operator.goose" },
    { "match": "[{}\\[\\]()]", "name": "punctuation.section.goose" },
    { "match": "[.,;:]", "name": "punctuation.separator.goose" }
  ],
  "repository": {
    "comments": { "patterns": [
      { "name": "comment.line.double-slash.goose", "begin": "//", "end": "$" },
      { "include": "#block-comment" }
    ] },
    "block-comment": { "name": "comment.block.goose", "begin": "/\\*", "end": "\\*/", "patterns": [{ "include": "#block-comment" }] },
    "strings": { "patterns": [
      { "name": "string.quoted.triple.goose", "begin": "\"\"\"", "end": "\"\"\"" },
      { "name": "string.quoted.double.goose", "begin": "\"", "end": "\"|$", "patterns": [{ "include": "#escapes" }] },
      { "name": "string.quoted.single.goose", "begin": "'", "end": "'|$", "patterns": [{ "include": "#escapes" }] }
    ] },
    "escapes": { "patterns": [
      { "match": "\\\\(?:[ntr0\\\\\"']|x[0-9a-fA-F]{2})", "name": "constant.character.escape.goose" },
      { "match": "\\\\.", "name": "invalid.illegal.escape.goose" }
    ] },
    "declarations": { "patterns": [
      { "match": "\\b(fn|thread_fn)\\s+((?:::)?(?:[A-Za-z_][A-Za-z0-9_]*::)*[A-Za-z_][A-Za-z0-9_]*)", "captures": { "1": { "name": "storage.type.function.goose" }, "2": { "name": "entity.name.function.goose" } } },
      { "match": "\\b(struct|enum|type)\\s+((?:::)?(?:[A-Za-z_][A-Za-z0-9_]*::)*[A-Za-z_][A-Za-z0-9_]*)", "captures": { "1": { "name": "storage.type.goose" }, "2": { "name": "entity.name.type.goose" } } },
      { "match": "\\b(namespace)\\s+([A-Za-z_][A-Za-z0-9_]*)", "captures": { "1": { "name": "keyword.other.goose" }, "2": { "name": "entity.name.namespace.goose" } } }
    ] },
    "numbers": { "patterns": [
      { "match": "\\b0[xX][0-9a-fA-F]+(?:\\.[0-9a-fA-F]+)?[pP][+-]?[0-9]+\\b", "name": "constant.numeric.float.hex.goose" },
      { "match": "\\b0[xX][0-9a-fA-F]+\\b", "name": "constant.numeric.integer.hex.goose" },
      { "match": "\\b[0-9]+(?:\\.[0-9]+(?:[eE][+-]?[0-9]+)?|[eE][+-]?[0-9]+)\\b", "name": "constant.numeric.float.goose" },
      { "match": "\\b[0-9]+\\b", "name": "constant.numeric.integer.goose" }
    ] }
  }
}
