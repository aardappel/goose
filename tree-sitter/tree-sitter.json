{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "goose",
      "camelcase": "Goose",
      "title": "Goose",
      "scope": "source.goose",
      "path": ".",
      "file-types": ["goose"],
      "highlights": "queries/highlights.scm",
      "injection-regex": "^goose$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "Apache-2.0",
    "description": "Goose grammar for tree-sitter",
    "authors": [{ "name": "Patrick Doane" }],
    "links": { "repository": "https://github.com/aardappel/goose" }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
