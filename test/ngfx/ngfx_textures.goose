// gfx_textures with the ngfx module, headless: 2D, 3D, cube and array
// textures, uploaded whole and by region and read back; sampled by shaders
// at texel centers with nearest filtering, so exactly, through indices in
// their roots; mips generated by compute and read; float texels; and
// rendering into one face of a cube.
import std;
import vec;
import os;
import ngfx;

// The roots of the shaders below: a texture and a sampler by index, and the
// mip level or the depth coordinate to sample at.
struct Sample { texture: u32, sampler: u32, at: f32 }

fn open_or_skip() -> bool {
    if ngfx::open_headless(64, 64) { return true; }
    write_stderr(str("ngfx: ", ngfx::error(), "\n"));
    return false;
}

fn texels(px: u8[:]) -> u8[>..] {
    var out: u8[>..] = [];
    for i in px.len / 4 {
        if i > 0 { out.push(' '); }
        format(out, px[i * 4], ",", px[i * 4 + 1], ",", px[i * 4 + 2], ",", px[i * 4 + 3]);
    }
    return out;
}

fn same(a: u8[:], b: u8[:]) -> bool {
    if a.len != b.len { return false; }
    for i in a.len {
        if a[i] != b[i] { return false; }
    }
    return true;
}

// One triangle covering the target, as the start of each module below: its
// texture coordinates run 0 to 1 over the target, (0, 0) at the top left.
let full = """
    #include <NoGraphicsAPI/shader.slang>
    struct Sample { uint texture; uint sampler; float at; };
    GPU_ROOT(Sample, root);
    struct Varyings { float4 position : SV_Position; float2 uv : TEXCOORD0; };
    [shader("vertex")]
    Varyings fullVertex(uint vertex_id : SV_VertexID) {
        float2 p = float2(float((vertex_id << 1) & 2), float(vertex_id & 2));
        Varyings o;
        o.uv = p;
        o.position = float4(p * 2.0 - 1.0, 0.0, 1.0);
        return o;
    }
    """;

fn main() {
    guard open_or_skip() else { return; }
    let nearest = ngfx::sampler(ngfx::NEAREST, ngfx::CLAMP);
    // 2D: a 4 x 4 pattern up and back, then a 2 x 2 region of it replaced.
    var pattern: u8[>..] = [];
    for i in 16 { pattern.append([(i * 16) as u8, (255 - i * 16) as u8, (i * 3) as u8, 255]); }
    let tex = ngfx::texture2d(4, 4);
    ngfx::update_texture(tex, pattern);
    let back = ngfx::read_pixels(tex);
    print("2d: read back as written ", same(back, pattern));
    let white: u8[16] = [255; 16];
    ngfx::update_texture(tex, ngfx::Region { x: 1, y: 1, w: 2, h: 2 }, white);
    let patched = ngfx::read_pixels(tex);
    print("2d: row 1 after a region update ", texels(patched[16..32]));

    // Sampling it into a target of its size, texel for texel, at the mip
    // level a uniform block gives.
    let sample2d = embed_slang(full, """
        [shader("fragment")]
        float4 sample2d(Varyings i) : SV_Target0 {
            Texture2D<float4> tex = gpu_texture<Texture2D<float4>>(root.texture);
            return tex.SampleLevel(gpu_sampler(root.sampler), i.uv, root.at);
        }
        """);
    let target = ngfx::render_target(4, 4, ngfx::RGBA8);
    let copy = ngfx::pipeline(sample2d);
    ngfx::begin_pass(target, ngfx::Texture { 0 }, float4 { 0.0, 0.0, 0.0, 0.0 });
    ngfx::bind(copy);
    ngfx::draw(ngfx::root(Sample { texture: ngfx::index(tex), sampler: ngfx::index(nearest), at: 0.0 }), 3);
    ngfx::end_pass();
    print("2d: sampled as written ", same(ngfx::read_pixels(target), patched));

    // Mips: four quadrants of 8 x 8, averaged down to the one texel of mip 3,
    // read back directly and sampled.
    let mipped = ngfx::texture(ngfx::TextureDesc { usage: ngfx::SAMPLED | ngfx::STORAGE, width: 8, height: 8,
                                                  mips: 0 });
    var quads: u8[>..] = [];
    for y in 8 {
        for x in 8 {
            let c: u8[4] = if y < 4 { if x < 4 { [255, 0, 0, 255] } else { [0, 255, 0, 255] } }
                           else { if x < 4 { [0, 0, 255, 255] } else { [255, 255, 255, 255] } };
            quads.append(c);
        }
    }
    ngfx::update_texture(mipped, quads);
    ngfx::generate_mips(mipped);
    ngfx::barrier(ngfx::COMPUTE_WRITE, ngfx::FRAGMENT_READ);
    let info = ngfx::texture_info(mipped);
    print("mips: ", info.width, " x ", info.height, " with ", info.mips, " levels");
    var last: u8[4] = [0; 4];
    ngfx::read_texture(mipped, ngfx::Region { mip: 3 }, last);
    let one = ngfx::render_target(1, 1, ngfx::RGBA8);
    ngfx::begin_pass(one, ngfx::Texture { 0 }, float4 { 0.0, 0.0, 0.0, 0.0 });
    ngfx::bind(copy);
    let linear = ngfx::sampler(ngfx::LINEAR, ngfx::CLAMP);
    ngfx::draw(ngfx::root(Sample { texture: ngfx::index(mipped), sampler: ngfx::index(linear), at: 3.0 }), 3);
    ngfx::end_pass();
    let sampled = ngfx::read_pixels(one);
    // Averaging rounds either way, depending on the GPU.
    var near = true;
    for i in 3 { near = near && abs(last[i] as i64 - 128) <= 2 && abs(sampled[i] as i64 - 128) <= 2; }
    print("mips: level 3 averages the quadrants ", near, ", alpha ", last[3], " ", sampled[3]);

    // 3D: a 2 x 2 x 2 volume, read back, and each slice sampled.
    var vol: u8[>..] = [];
    for i in 8 { vol.append([(i * 30) as u8, (i * 5) as u8, 200, 255]); }
    let volume = ngfx::texture3d(2, 2, 2, ngfx::RGBA8, ngfx::SAMPLED);
    ngfx::update_texture(volume, vol);
    print("3d: read back as written ", same(ngfx::read_pixels(volume), vol));
    // One slice of a volume, by depth coordinate.
    let sample3d = embed_slang(full, """
        [shader("fragment")]
        float4 sample3d(Varyings i) : SV_Target0 {
            Texture3D<float4> volume = gpu_texture<Texture3D<float4>>(root.texture);
            return volume.Sample(gpu_sampler(root.sampler), float3(i.uv, root.at));
        }
        """);
    let slice_target = ngfx::render_target(2, 2, ngfx::RGBA8);
    let slicer = ngfx::pipeline(sample3d);
    for z in 2 {
        ngfx::begin_pass(slice_target, ngfx::Texture { 0 }, float4 { 0.0, 0.0, 0.0, 0.0 });
        ngfx::bind(slicer);
        ngfx::draw(ngfx::root(Sample { texture: ngfx::index(volume), sampler: ngfx::index(nearest),
                                       at: (z + 0.5) / 2.0 }), 3);
        ngfx::end_pass();
        print("3d: slice ", z, " sampled as written ",
              same(ngfx::read_pixels(slice_target), vol[z * 16..z * 16 + 16]));
    }

    // Cube: one color per face, each uploaded as its own layer, then looked
    // up along each axis.
    let faces: u8[4][6] = [[255, 0, 0, 255], [0, 255, 0, 255], [0, 0, 255, 255],
                           [255, 255, 0, 255], [0, 255, 255, 255], [255, 0, 255, 255]];
    let sky = ngfx::texture_cube(1, ngfx::RGBA8, ngfx::SAMPLED);
    for f in 6 { ngfx::update_texture(sky, ngfx::Region { layer: f as i32 }, faces[f]); }
    // Pixel x of a 6 x 1 target looks along cube face x's axis: +x, -x, +y,
    // -y, +z, -z.
    let along_axes = embed_slang(full, """
        [shader("fragment")]
        float4 alongAxes(Varyings i) : SV_Target0 {
            TextureCube<float4> sky = gpu_texture<TextureCube<float4>>(root.texture);
            int face = int(i.position.x);
            float3 dir = float3(1.0, 0.0, 0.0);
            if (face == 1) dir = float3(-1.0, 0.0, 0.0);
            if (face == 2) dir = float3(0.0, 1.0, 0.0);
            if (face == 3) dir = float3(0.0, -1.0, 0.0);
            if (face == 4) dir = float3(0.0, 0.0, 1.0);
            if (face == 5) dir = float3(0.0, 0.0, -1.0);
            return sky.Sample(gpu_sampler(root.sampler), dir);
        }
        """);
    let axes = ngfx::render_target(6, 1, ngfx::RGBA8);
    ngfx::begin_pass(axes, ngfx::Texture { 0 }, float4 { 0.0, 0.0, 0.0, 0.0 });
    ngfx::bind(ngfx::pipeline(along_axes));
    ngfx::draw(ngfx::root(Sample { texture: ngfx::index(sky), sampler: ngfx::index(nearest), at: 0.0 }), 3);
    ngfx::end_pass();
    print("cube: +x -x +y -y +z -z ", texels(ngfx::read_pixels(axes)));

    // An array: one color per layer, each layer sampled.
    let layered = ngfx::texture_array(1, 1, 3, ngfx::RGBA8, ngfx::SAMPLED);
    for l in 3 { ngfx::update_texture(layered, ngfx::Region { layer: l as i32 }, faces[l + 3]); }
    // Pixel x of an N x 1 target samples layer x.
    let by_layer = embed_slang(full, """
        [shader("fragment")]
        float4 byLayer(Varyings i) : SV_Target0 {
            Texture2DArray<float4> layers = gpu_texture<Texture2DArray<float4>>(root.texture);
            return layers.Sample(gpu_sampler(root.sampler), float3(0.5, 0.5, floor(i.position.x)));
        }
        """);
    let row = ngfx::render_target(3, 1, ngfx::RGBA8);
    ngfx::begin_pass(row, ngfx::Texture { 0 }, float4 { 0.0, 0.0, 0.0, 0.0 });
    ngfx::bind(ngfx::pipeline(by_layer));
    ngfx::draw(ngfx::root(Sample { texture: ngfx::index(layered), sampler: ngfx::index(nearest), at: 0.0 }), 3);
    ngfx::end_pass();
    print("array: layers 0 1 2 ", texels(ngfx::read_pixels(row)));

    // Rendering into one face of a cube: clearing face 4.
    let env = ngfx::texture_cube(2, ngfx::RGBA8, ngfx::COLOR_TARGET | ngfx::SAMPLED);
    var face_pass = ngfx::PassDesc { layer: 4, color_value: float4 { 1.0, 0.2, 0.0, 1.0 } };
    face_pass.color[0] = env;
    ngfx::begin_pass(face_pass);
    ngfx::end_pass();
    var face4: u8[16] = [0; 16];
    ngfx::read_texture(env, ngfx::Region { layer: 4 }, face4);
    print("cube face 4 cleared: ", texels(face4));

    // Float texels, exactly.
    let hdr = ngfx::texture2d(2, 1, ngfx::RGBA32F, ngfx::SAMPLED);
    let values: float4[2] = [float4 { 0.5, -1.25, 1000.0, 1.0 }, float4 { 3.0, 0.0, -0.125, 2.0 }];
    ngfx::update_texture(hdr, bytes_of(values));
    var floats: float4[>..] = [];
    ngfx::read_texture(hdr, floats);
    print("float texels: ", floats[0], " ", floats[1]);
    ngfx::close();
}
