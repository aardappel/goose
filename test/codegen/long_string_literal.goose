        """;
    var lines = 1;
    var sum = 0;
    for c in text {
        if c == '\n' { lines++; }
        sum += c as i64;
    }
    print(text.len, " bytes, ", lines, " lines, byte sum ", sum);
    print(text[..16], " ... ", text[text.len - 16..]);
}
