# Builtin packages (docs/design/packages.md §7.1): the blessed packages that
# GOOSE_BUILTIN_LIBS names (src/blessed.txt), taken from this tree or fetched
# at configure time with CMake's own fetcher, built with their own
# CMakeLists (or from the C their sidecar lists) and linked into the
# compiler, with a symbol table for JIT runs (what the compiler generates for
# a package it builds itself, native.h, generated here by a regular
# expression over the package's .goose files, since no compiler exists yet)
# and, once the compiler is linked, a response file holding the package's
# whole link closure for the programs `goose build` links, read from CMake's
# own file API reply by cmake/linkclosure.cmake.

include_guard(GLOBAL)
include(FetchContent)

# The rows of src/blessed.txt, each "import|package|source|ref".
function(goose_blessed_rows outvar)
    file(STRINGS "${CMAKE_SOURCE_DIR}/src/blessed.txt" lines)
    set(rows)
    foreach(line IN LISTS lines)
        string(REGEX REPLACE "#.*" "" line "${line}")
        string(STRIP "${line}" line)
        if(line STREQUAL "")
            continue()
        endif()
        string(REGEX REPLACE "[ \t]+" "|" row "${line}")
        string(REPLACE "|" ";" fields "${row}")
        list(LENGTH fields nfields)
        if(NOT nfields EQUAL 4)
            message(FATAL_ERROR "src/blessed.txt: a row has ${nfields} fields, not 4: ${line}")
        endif()
        list(APPEND rows "${row}")
    endforeach()
    set(${outvar} "${rows}" PARENT_SCOPE)
endfunction()

# One value of a sidecar (a string, true/false, or a [list] of strings as a
# CMake list), or "" when the key is absent.
function(goose_sidecar_value sidecar key outvar)
    string(REGEX REPLACE "//[^\n]*" "" text "${sidecar}")
    set(value "")
    if(text MATCHES "(^|[\n;])[ \t]*${key}[ \t]*=[ \t]*\"([^\"]*)\"[ \t]*;")
        set(value "${CMAKE_MATCH_2}")
    elseif(text MATCHES "(^|[\n;])[ \t]*${key}[ \t]*=[ \t]*(true|false)[ \t]*;")
        set(value "${CMAKE_MATCH_2}")
    elseif(text MATCHES "(^|[\n;])[ \t]*${key}[ \t]*=[ \t]*\\[([^]]*)\\][ \t]*;")
        string(REGEX MATCHALL "\"[^\"]*\"" items "${CMAKE_MATCH_2}")
        foreach(item IN LISTS items)
            string(REGEX REPLACE "^\"(.*)\"$" "\\1" item "${item}")
            list(APPEND value "${item}")
        endforeach()
    endif()
    set(${outvar} "${value}" PARENT_SCOPE)
endfunction()

# The C of the package's symbol table: goose_symbols_<name>, as native.h
# writes goose_symbols for a package the compiler builds itself. The names
# are every `extern fn name(...) = "sym"` (or the deprecated `extern "sym" fn`)
# and `extern fn name` (or `ns::name`) in the package's .goose files, comments
# stripped. A match runs to the declaration's `;`, which it leaves out (a `;`
# would split the list), so a symbol after the signature ends it.
function(goose_symbol_table pkgroot pkgname outfile)
    file(GLOB_RECURSE goosefiles "${pkgroot}/*.goose")
    set(names)
    foreach(f IN LISTS goosefiles)
        file(READ "${f}" text)
        string(REGEX REPLACE "//[^\n]*" "" text "${text}")
        string(REGEX MATCHALL
               "extern[ \t\r\n]+(\"[A-Za-z_][A-Za-z0-9_]*\"[ \t\r\n]+)?fn[ \t\r\n]+[A-Za-z_][A-Za-z0-9_]*(::[A-Za-z_][A-Za-z0-9_]*)?[^;]*"
               matches "${text}")
        foreach(m IN LISTS matches)
            if(m MATCHES "=[ \t\r\n]*\"([A-Za-z_][A-Za-z0-9_]*)\"[ \t\r\n]*$")
                list(APPEND names "${CMAKE_MATCH_1}")
            elseif(m MATCHES "^extern[ \t\r\n]+\"([A-Za-z_][A-Za-z0-9_]*)\"")
                list(APPEND names "${CMAKE_MATCH_1}")
            elseif(m MATCHES "^extern[ \t\r\n]+fn[ \t\r\n]+([A-Za-z_][A-Za-z0-9_]*)::([A-Za-z_][A-Za-z0-9_]*)")
                list(APPEND names "${CMAKE_MATCH_2}")
            elseif(m MATCHES "^extern[ \t\r\n]+fn[ \t\r\n]+([A-Za-z_][A-Za-z0-9_]*)")
                list(APPEND names "${CMAKE_MATCH_1}")
            endif()
        endforeach()
    endforeach()
    if(names)
        list(REMOVE_DUPLICATES names)
        list(SORT names)
    endif()
    set(src "/* Generated by cmake/package.cmake for the builtin package ${pkgname}: the C\n")
    string(APPEND src "   functions its extern fns name, which a JIT run looks up through\n")
    string(APPEND src "   goose_symbols_${pkgname}. Do not edit. */\n\n")
    string(APPEND src "typedef struct { const char *name; const void *addr; } goose_symbol;\n\n")
    foreach(n IN LISTS names)
        string(APPEND src "void ${n}(void);\n")
    endforeach()
    string(APPEND src "\nconst goose_symbol *goose_symbols_${pkgname}(void) {\n")
    string(APPEND src "    static const goose_symbol table[] = {\n")
    foreach(n IN LISTS names)
        string(APPEND src "        { \"${n}\", (const void *)&${n} },\n")
    endforeach()
    string(APPEND src "        { 0, 0 }\n    };\n    return table;\n}\n")
    file(CONFIGURE OUTPUT "${outfile}" CONTENT "${src}" @ONLY)
endfunction()

# Builds the blessed package `pkgname` from `source` at `ref` into the
# compiler. A path source is a directory of this tree; a git source is
# fetched into the build tree. A package whose CMakeLists builds nothing
# (a submodule it needs is not checked out) is reported and left out.
function(goose_builtin_package pkgname source ref)
    if(source MATCHES "^\\./" OR source MATCHES "^\\.\\./" OR source MATCHES "^/")
        get_filename_component(srcdir "${CMAKE_SOURCE_DIR}/${source}" ABSOLUTE)
    else()
        if(source MATCHES "://" OR source MATCHES "@")
            set(url "${source}")
        else()
            string(REGEX MATCHALL "/" slashes "${source}")
            list(LENGTH slashes nslashes)
            if(nslashes EQUAL 1)
                set(url "https://github.com/${source}")
            else()
                set(url "https://${source}")
            endif()
        endif()
        FetchContent_Declare(goose_pkg_${pkgname}
            GIT_REPOSITORY "${url}" GIT_TAG "${ref}" GIT_SHALLOW TRUE GIT_SUBMODULES_RECURSE TRUE
            SOURCE_DIR "${CMAKE_BINARY_DIR}/pkg/src/${pkgname}/${ref}")
        FetchContent_GetProperties(goose_pkg_${pkgname})
        if(NOT goose_pkg_${pkgname}_POPULATED)
            message(STATUS "package ${pkgname}: fetching ${url} at ${ref}")
            FetchContent_Populate(goose_pkg_${pkgname})
        endif()
        set(srcdir "${goose_pkg_${pkgname}_SOURCE_DIR}")
    endif()
    if(NOT EXISTS "${srcdir}/${pkgname}.goose")
        message(FATAL_ERROR "package ${pkgname}: ${srcdir} has no ${pkgname}.goose")
    endif()
    set(target "")
    if(EXISTS "${srcdir}/${pkgname}.build")
        file(READ "${srcdir}/${pkgname}.build" sidecar)
        goose_sidecar_value("${sidecar}" cmake_target target)
        if(target)
            add_subdirectory("${srcdir}" "${CMAKE_BINARY_DIR}/pkg/build/${pkgname}" EXCLUDE_FROM_ALL)
            if(NOT TARGET ${target})
                message(STATUS "package ${pkgname}: its CMakeLists built nothing, so it is not "
                               "compiled in (a submodule it needs may not be checked out)")
                return()
            endif()
        else()
            goose_sidecar_value("${sidecar}" c_sources sources)
            if(sources)
                set(target goose_pkg_${pkgname})
                set(abs)
                foreach(s IN LISTS sources)
                    list(APPEND abs "${srcdir}/${s}")
                endforeach()
                add_library(${target} STATIC ${abs})
                goose_sidecar_value("${sidecar}" c_include includes)
                foreach(i IN LISTS includes)
                    target_include_directories(${target} PRIVATE "${srcdir}/${i}")
                endforeach()
                goose_sidecar_value("${sidecar}" c_defines defines)
                if(defines)
                    target_compile_definitions(${target} PRIVATE ${defines})
                endif()
                goose_sidecar_value("${sidecar}" c_libs libs)
                if(libs)
                    target_link_libraries(${target} PUBLIC ${libs})
                endif()
            endif()
        endif()
    endif()
    set_property(GLOBAL APPEND PROPERTY GOOSE_BUILTIN_NAMES "${pkgname}")
    set_property(GLOBAL APPEND PROPERTY GOOSE_BUILTIN_SRCDIRS "${srcdir}/")
    if(NOT target)
        # Pure Goose: the compiler only needs to know where its files are.
        set_property(GLOBAL APPEND PROPERTY GOOSE_BUILTIN_RSPDIRS "")
        message(STATUS "package ${pkgname}: built in from ${srcdir} (Goose only)")
        return()
    endif()
    target_link_libraries(goose PRIVATE ${target})
    set(gen "${CMAKE_BINARY_DIR}/generated")
    goose_symbol_table("${srcdir}" "${pkgname}" "${gen}/goose_symbols_${pkgname}.c")
    target_sources(goose PRIVATE "${gen}/goose_symbols_${pkgname}.c")
    set_source_files_properties("${gen}/goose_symbols_${pkgname}.c" PROPERTIES
                                COMPILE_OPTIONS "$<IF:$<BOOL:${MSVC}>,/w,-w>")
    # A probe whose link line is the package's whole link closure, which
    # linkclosure.cmake reads from the file API reply once goose is built,
    # into the response file goose build links programs with.
    file(CONFIGURE OUTPUT "${gen}/goose_linkprobe_${pkgname}.c"
         CONTENT "/* Its link line is the package's link closure. */\nint main(void) { return 0; }\n")
    add_executable(goose_linkprobe_${pkgname} EXCLUDE_FROM_ALL "${gen}/goose_linkprobe_${pkgname}.c")
    target_link_libraries(goose_linkprobe_${pkgname} PRIVATE ${target})
    set(rspdir "${CMAKE_BINARY_DIR}/pkg/${pkgname}")
    add_custom_command(TARGET goose POST_BUILD
        COMMAND "${CMAKE_COMMAND}" "-DREPLY_DIR=${CMAKE_BINARY_DIR}/.cmake/api/v1/reply"
                "-DTARGET=goose_linkprobe_${pkgname}" "-DCONFIG=$<CONFIG>"
                "-DBUILD_DIR=${CMAKE_BINARY_DIR}" "-DOUT_DIR=${rspdir}/$<CONFIG>"
                -P "${CMAKE_SOURCE_DIR}/cmake/linkclosure.cmake"
        COMMENT "link closure of the package ${pkgname}"
        VERBATIM)
    set_property(GLOBAL APPEND PROPERTY GOOSE_BUILTIN_RSPDIRS "${rspdir}")
    target_compile_definitions(goose PRIVATE "GOOSE_BUILTIN_RSPDIR_${pkgname}=\"${rspdir}/$<CONFIG>\"")
    message(STATUS "package ${pkgname}: built in from ${srcdir}")
endfunction()

# The packages `wanted` names (`all`, or a list of import names) built in,
# and the header the compiler reads them from, builtin_packages.h, which
# also carries the blessed table itself.
function(goose_builtin_packages wanted)
    goose_blessed_rows(rows)
    set(done)
    foreach(row IN LISTS rows)
        string(REPLACE "|" ";" fields "${row}")
        list(GET fields 0 import)
        list(GET fields 1 pkg)
        list(GET fields 2 source)
        list(GET fields 3 ref)
        if(NOT (wanted STREQUAL "all" OR import IN_LIST wanted OR pkg IN_LIST wanted))
            continue()
        endif()
        if(pkg IN_LIST done)
            continue()
        endif()
        list(APPEND done "${pkg}")
        goose_builtin_package("${pkg}" "${source}" "${ref}")
    endforeach()
    # The file API reply, written as this build generates, is where
    # linkclosure.cmake reads the probes' link lines after goose is built.
    # A query file written during configure is only read on the next run.
    # Request this run's reply so a clean build has the link lines too.
    cmake_file_api(QUERY API_VERSION 1 CODEMODEL 2)
    get_property(names GLOBAL PROPERTY GOOSE_BUILTIN_NAMES)
    get_property(srcdirs GLOBAL PROPERTY GOOSE_BUILTIN_SRCDIRS)
    get_property(rspdirs GLOBAL PROPERTY GOOSE_BUILTIN_RSPDIRS)
    file(READ "${CMAKE_SOURCE_DIR}/src/blessed.txt" blessed)
    set(h "// Generated by cmake/package.cmake: the blessed table and the packages compiled\n")
    string(APPEND h "// into this compiler. Do not edit.\n#pragma once\n\nnamespace goose {\n\n")
    string(APPEND h "inline const char *blessed_table = R\"GSBL(${blessed})GSBL\";\n\n")
    set(i 0)
    foreach(n IN LISTS names)
        list(GET rspdirs ${i} rspdir)
        if(rspdir)
            string(APPEND h "extern \"C\" const goose_symbol *goose_symbols_${n}(void);\n")
        endif()
        math(EXPR i "${i} + 1")
    endforeach()
    string(APPEND h "\ninline const BuiltinPackage builtin_packages[] = {\n")
    set(i 0)
    foreach(n IN LISTS names)
        list(GET srcdirs ${i} srcdir)
        list(GET rspdirs ${i} rspdir)
        if(rspdir)
            string(APPEND h "    { \"${n}\", goose_symbols_${n}, \"${srcdir}\", GOOSE_BUILTIN_RSPDIR_${n} },\n")
        else()
            string(APPEND h "    { \"${n}\", nullptr, \"${srcdir}\", \"\" },\n")
        endif()
        math(EXPR i "${i} + 1")
    endforeach()
    string(APPEND h "    { nullptr, nullptr, nullptr, nullptr },\n};\n\n}  // namespace goose\n")
    file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/generated/builtin_packages.h" CONTENT "${h}" @ONLY)
    target_include_directories(goose PRIVATE "${CMAKE_BINARY_DIR}/generated")
endfunction()
